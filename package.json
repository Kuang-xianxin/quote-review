{
  "name": "quote-review",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node scripts/build-quotes.mjs",
    "start": "node --import tsx server/local.ts",
    "lint": "eslint app/quotes.tsx app/main.tsx core/quotes.ts server db tests/quotes.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "python worker/benchmark.py",
    "format:check": "prettier --check app/quotes.tsx app/main.tsx app/quotes.css core/quotes.ts server db tests/quotes.test.ts README.md README.zh-CN.md docs",
    "backend": "node --import tsx server/local.ts",
    "test:quotes": "tsx --test tests/quotes.test.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "Review bilingual supplier quotations with local AI, source evidence and comparable unit prices",
  "license": "MIT"
}
