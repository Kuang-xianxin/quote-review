{
  "name": "incident-weave",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 5173",
    "lint": "eslint app/page.tsx app/main.tsx core tests scripts/investigate.ts scripts/evaluate.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/evaluate.ts",
    "investigate": "tsx scripts/investigate.ts",
    "format:check": "prettier --check app/page.tsx app/main.tsx app/globals.css core tests scripts/investigate.ts scripts/evaluate.ts docs README.md"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "Local-first AI incident investigation with traceable evidence and no paid APIs",
  "license": "MIT"
}
